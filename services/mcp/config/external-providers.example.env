# Public AviationWeather.gov source. No credential is required.
MXGENIUS_AVIATION_WEATHER_ENDPOINT=https://aviationweather.gov/api/data/
MXGENIUS_AVIATION_WEATHER_USER_AGENT=MxGenius/0.1 (https://mxgenius.io)

# Deliberate XR still-frame analysis. Disabled by default. The provider key is
# server-only and the endpoint performs at most one model request per cache miss.
MXGENIUS_SPATIAL_SCAN_ENABLED=false
# OPENAI_API_KEY=
# MXGENIUS_SPATIAL_SCAN_MODEL=gpt-5.4-mini
# MXGENIUS_SPATIAL_SCAN_MAX_EDGE=1280
# MXGENIUS_SPATIAL_SCAN_MAX_BYTES=1048576
# MXGENIUS_SPATIAL_SCAN_TIMEOUT_MS=8000
# MXGENIUS_SPATIAL_SCAN_COOLDOWN_MS=2000
# MXGENIUS_SPATIAL_SCAN_RATE_PER_MINUTE=12
# MXGENIUS_SPATIAL_SCAN_DAILY_LIMIT=100
# MXGENIUS_SPATIAL_SCAN_CACHE_ENTRIES=32
# MXGENIUS_SPATIAL_SCAN_CACHE_TTL_SECONDS=60

# Short-lived anonymous guest Remote Witness rooms. Signaling/state remains on the
# core WSS route; continuous media is peer-to-peer WebRTC and is never posted
# to MCP. Do not put durable TURN passwords in this file or runtime config.
# MXGENIUS_WITNESS_INVITE_TTL_SECONDS=300
# MXGENIUS_WITNESS_SESSION_TTL_SECONDS=3600
# MXGENIUS_WITNESS_MAX_VIEWERS=1
# MXGENIUS_WITNESS_ICE_SERVERS_JSON=[{"urls":["stun:stun.example.com:3478"]}]
