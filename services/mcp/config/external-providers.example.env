# Public AviationWeather.gov source. No credential is required.
MXGENIUS_AVIATION_WEATHER_ENDPOINT=https://aviationweather.gov/api/data/
MXGENIUS_AVIATION_WEATHER_USER_AGENT=MxGenius/0.1 (https://mxgenius.io)

# PartsBase remains disabled until issued credentials and live payload validation.
MXGENIUS_PARTSBASE_AUTH_MODE=disabled
MXGENIUS_PARTSBASE_ENDPOINT=https://services.partsbase.com/
MXGENIUS_PARTSBASE_TOKEN_ENDPOINT=https://auth.partsbase.com/connect/token
MXGENIUS_PARTSBASE_SCOPE=api

# Select the vendor-documented activation path during live equipment testing:
# MXGENIUS_PARTSBASE_AUTH_MODE=oauth_password
# MXGENIUS_PARTSBASE_CLIENT_ID=
# MXGENIUS_PARTSBASE_CLIENT_SECRET=
# MXGENIUS_PARTSBASE_USERNAME=
# MXGENIUS_PARTSBASE_PASSWORD=

# Generic broker seam for a provider that explicitly supports browser OAuth.
# The callback/refresh service is intentionally not enabled in this POC.
# MXGENIUS_PARTSBASE_AUTH_MODE=browser_broker
# MXGENIUS_PARTSBASE_BEARER_FILE=/run/secrets/mxgenius/partsbase.token
