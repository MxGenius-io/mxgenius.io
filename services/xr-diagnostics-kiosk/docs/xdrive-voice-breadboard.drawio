  <diagram id="xdrive-voice-poc" name="1 · System overview">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="XDrive voice control · Raspberry Pi 5" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="46" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Bench POC wiring contract · page 2 is the GPIO breadboard · page 3 is audio, display, and power" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="42" y="69" width="1250" height="30" as="geometry"/></mxCell>
        <mxCell id="mic" value="&lt;b&gt;Raw electret mic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;+ to biased MIC signal&lt;br&gt;− to MIC sleeve&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontColor=#0D47A1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="45" y="245" width="135" height="135" as="geometry"/></mxCell>
        <mxCell id="mic-adapter" value="&lt;b&gt;USB audio adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;class compliant&lt;br&gt;MIC input must supply electret bias&lt;br&gt;headphone / line output&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#4A148C;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="255" y="225" width="250" height="175" as="geometry"/></mxCell>
        <mxCell id="pi" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="540" height="540" as="geometry"/></mxCell>
        <mxCell id="pi-title" value="&lt;b&gt;Raspberry Pi 5&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;XDrive Chromium kiosk + gpiozero hardware service&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=23;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="720" y="170" width="380" height="70" as="geometry"/></mxCell>
        <mxCell id="usb" value="&lt;b&gt;USB-A host&lt;/b&gt;&lt;br&gt;USB audio adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=2;fontColor=#4A148C;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="695" y="265" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="gpio" value="&lt;b&gt;40-pin header&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;inputs: 17, 5, 6, 12, 13, 16, 19, 20, 21, 26&lt;br&gt;outputs: 22, 23, 24&lt;br&gt;common GND: physical pin 20&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=16;arcSize=8;" vertex="1" parent="1"><mxGeometry x="910" y="265" width="225" height="150" as="geometry"/></mxCell>
        <mxCell id="hdmi" value="&lt;b&gt;micro-HDMI&lt;/b&gt;&lt;br&gt;display video" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=2;fontColor=#006064;fontSize=15;arcSize=10;" vertex="1" parent="1"><mxGeometry x="695" y="380" width="180" height="75" as="geometry"/></mxCell>
        <mxCell id="j2" value="&lt;b&gt;J2 external power-button pads&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;dry contact only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=2;fontColor=#B71C1C;fontSize=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="910" y="455" width="225" height="90" as="geometry"/></mxCell>
        <mxCell id="fivev" value="&lt;b&gt;5 V / GND&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;pin 4 / pin 6&lt;br&gt;amp only if supply budget allows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=2;fontColor=#263238;fontSize=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="695" y="495" width="180" height="105" as="geometry"/></mxCell>
        <mxCell id="display" value="&lt;b&gt;Small HDMI display&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;micro-HDMI video&lt;br&gt;rated USB power / touch&lt;/font&gt;" style="shape=mxgraph.basic.rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=3;fontColor=#006064;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1375" y="120" width="300" height="155" as="geometry"/></mxCell>
        <mxCell id="amp" value="&lt;b&gt;5 V mono amplifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PAM8302-class module&lt;br&gt;IN from one headphone channel&lt;br&gt;SPK+ / SPK− are a floating pair&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;fontColor=#880E4F;fontSize=16;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1355" y="350" width="275" height="170" as="geometry"/></mxCell>
        <mxCell id="speaker" value="&lt;b&gt;Raw speaker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;confirm Ω and watts&lt;br&gt;connect only to SPK+ / SPK−&lt;/font&gt;" style="shape=mxgraph.electrical.audio.speaker;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;fontColor=#880E4F;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1740" y="375" width="105" height="125" as="geometry"/></mxCell>
        <mxCell id="talk" value="&lt;b&gt;TALK / trigger&lt;/b&gt;&lt;br&gt;GPIO17 · pin 11&lt;br&gt;NO switch to GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=3;fontColor=#5D4037;fontSize=15;arcSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="leds" value="&lt;b&gt;Three status LEDs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;LOCAL green · GPIO22 / pin 15&lt;br&gt;CLOUD blue · GPIO23 / pin 16&lt;br&gt;LISTEN amber · GPIO24 / pin 18&lt;br&gt;each LED → 330 Ω → GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;fontColor=#1B5E20;fontSize=15;arcSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="700" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="nav" value="&lt;b&gt;Six-button navigation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;UP 5 / 29 · DOWN 6 / 31&lt;br&gt;LEFT 12 / 32 · RIGHT 13 / 33&lt;br&gt;OK 16 / 36 · BACK 19 / 35&lt;br&gt;all NO switches to GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=3;fontColor=#5D4037;fontSize=15;arcSize=14;" vertex="1" parent="1"><mxGeometry x="650" y="700" width="285" height="145" as="geometry"/></mxCell>
        <mxCell id="encoder" value="&lt;b&gt;Volume encoder + push&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;A: GPIO20 / pin 38&lt;br&gt;B: GPIO21 / pin 40&lt;br&gt;push MUTE: GPIO26 / pin 37&lt;br&gt;common + push return to GND&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=3;fontColor=#5D4037;fontSize=15;arcSize=14;" vertex="1" parent="1"><mxGeometry x="985" y="700" width="275" height="145" as="geometry"/></mxCell>
        <mxCell id="power" value="&lt;b&gt;POWER&lt;/b&gt;&lt;br&gt;NO momentary switch&lt;br&gt;across J2 pads only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=3;fontColor=#B71C1C;fontSize=15;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1310" y="720" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="ground" value="&lt;b&gt;Breadboard GND rail&lt;/b&gt; · Pi physical pin 20&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;shared by GPIO buttons, encoder, and LED resistors — never connect J2 to this rail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#455A64;strokeWidth=3;fontColor=#263238;fontSize=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="330" y="900" width="930" height="75" as="geometry"/></mxCell>
        <mxCell id="warning" value="&lt;b&gt;3.3 V GPIO ONLY&lt;/b&gt; · Inputs use internal pull-ups and close to GND. Do not place 5 V or 3.3 V on any switch. J2 is a separate dry-contact circuit. Never drive the raw speaker from GPIO or the USB adapter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=3;fontColor=#BF360C;fontSize=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="150" y="1040" width="1580" height="80" as="geometry"/></mxCell>
        <mxCell id="mic-edge" value="biased mic signal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1976D2;strokeWidth=3;fontColor=#0D47A1;fontSize=12;" edge="1" parent="1" source="mic" target="mic-adapter"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="usb-edge" value="USB digital audio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B1FA2;strokeWidth=3;fontColor=#4A148C;fontSize=12;" edge="1" parent="1" source="mic-adapter" target="usb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="headphone-edge" value="one headphone channel + audio GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B1FA2;strokeWidth=3;fontColor=#4A148C;fontSize=12;" edge="1" parent="1" source="mic-adapter" target="amp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="speaker-edge" value="SPK+ / SPK−" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C2185B;strokeWidth=4;fontColor=#880E4F;fontSize=12;" edge="1" parent="1" source="amp" target="speaker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="display-edge" value="micro-HDMI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#00838F;strokeWidth=3;fontColor=#006064;fontSize=12;" edge="1" parent="1" source="hdmi" target="display"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gpio-talk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#F9A825;strokeWidth=3;" edge="1" parent="1" source="gpio" target="talk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gpio-leds" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="gpio" target="leds"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gpio-nav" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#F9A825;strokeWidth=3;" edge="1" parent="1" source="gpio" target="nav"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gpio-encoder" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#F9A825;strokeWidth=3;" edge="1" parent="1" source="gpio" target="encoder"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="j2-power" value="brief closure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#D32F2F;strokeWidth=4;fontColor=#B71C1C;fontSize=12;" edge="1" parent="1" source="j2" target="power"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="xdrive-gpio-breadboard" name="2 · GPIO breadboard">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p2-title" value="GPIO breadboard · literal wire map" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="850" height="45" as="geometry"/></mxCell>
        <mxCell id="p2-sub" value="BCM numbering is used by software; physical pin numbers are shown for wiring. Disconnect Pi power before changing wires." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="42" y="70" width="1400" height="30" as="geometry"/></mxCell>
        <mxCell id="header" value="&lt;b&gt;Raspberry Pi 5 selected pins&lt;/b&gt;&lt;br&gt;&lt;br&gt;11 · GPIO17 · TALK&lt;br&gt;15 · GPIO22 · LOCAL LED&lt;br&gt;16 · GPIO23 · CLOUD LED&lt;br&gt;18 · GPIO24 · LISTEN LED&lt;br&gt;20 · GND · common rail&lt;br&gt;29 · GPIO5 · UP&lt;br&gt;31 · GPIO6 · DOWN&lt;br&gt;32 · GPIO12 · LEFT&lt;br&gt;33 · GPIO13 · RIGHT&lt;br&gt;35 · GPIO19 · BACK&lt;br&gt;36 · GPIO16 · OK&lt;br&gt;37 · GPIO26 · MUTE push&lt;br&gt;38 · GPIO20 · encoder A&lt;br&gt;40 · GPIO21 · encoder B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;fontColor=#1B5E20;fontSize=15;align=left;spacingLeft=18;verticalAlign=top;spacingTop=14;arcSize=8;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="310" height="610" as="geometry"/></mxCell>
        <mxCell id="board" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#78909C;strokeWidth=3;arcSize=4;" vertex="1" parent="1"><mxGeometry x="445" y="145" width="1390" height="820" as="geometry"/></mxCell>
        <mxCell id="rail-neg" value="GND rail · from physical pin 20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#263238;strokeWidth=4;fontColor=#263238;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="875" width="1270" height="45" as="geometry"/></mxCell>
        <mxCell id="led-head" value="STATUS OUTPUTS · each branch is GPIO → LED anode → LED cathode → 330 Ω → GND" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#1B5E20;" vertex="1" parent="1"><mxGeometry x="500" y="175" width="1100" height="35" as="geometry"/></mxCell>
        <mxCell id="local" value="pin 15 · GPIO22&lt;br&gt;→ green LOCAL LED → 330 Ω → GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="235" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="cloud" value="pin 16 · GPIO23&lt;br&gt;→ blue CLOUD LED → 330 Ω → GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;strokeWidth=2;fontColor=#0D47A1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="960" y="235" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="listen" value="pin 18 · GPIO24&lt;br&gt;→ amber LISTEN LED → 330 Ω → GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#EF6C00;strokeWidth=2;fontColor=#BF360C;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1400" y="235" width="350" height="75" as="geometry"/></mxCell>
        <mxCell id="button-head" value="ACTIVE-LOW BUTTONS · listed GPIO → normally-open switch → GND rail · internal pull-up enabled" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#5D4037;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="1250" height="35" as="geometry"/></mxCell>
        <mxCell id="talk-b" value="TALK&lt;br&gt;GPIO17 · pin 11" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="520" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="up-b" value="UP&lt;br&gt;GPIO5 · pin 29" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="705" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="down-b" value="DOWN&lt;br&gt;GPIO6 · pin 31" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="890" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="left-b" value="LEFT&lt;br&gt;GPIO12 · pin 32" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1075" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="right-b" value="RIGHT&lt;br&gt;GPIO13 · pin 33" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1260" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="ok-b" value="OK&lt;br&gt;GPIO16 · pin 36" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1445" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="back-b" value="BACK&lt;br&gt;GPIO19 · pin 35" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1630" y="425" width="150" height="75" as="geometry"/></mxCell>
        <mxCell id="return-note" value="Wire the second terminal of every button above to the single GND rail." style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=2;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="680" y="525" width="950" height="30" as="geometry"/></mxCell>
        <mxCell id="enc-head" value="PASSIVE ROTARY ENCODER · no VCC connection required" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontStyle=1;fontColor=#4A148C;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="700" height="35" as="geometry"/></mxCell>
        <mxCell id="encoder" value="&lt;b&gt;ROTARY ENCODER&lt;/b&gt;&lt;br&gt;&lt;br&gt;A / CLK → GPIO20 · pin 38&lt;br&gt;B / DT → GPIO21 · pin 40&lt;br&gt;C / COM → GND rail&lt;br&gt;SW → GPIO26 · pin 37&lt;br&gt;SW return → GND rail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#7B1FA2;strokeWidth=3;fontColor=#4A148C;fontSize=15;align=left;spacingLeft=20;arcSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="650" width="330" height="175" as="geometry"/></mxCell>
        <mxCell id="logic-note" value="&lt;b&gt;Software behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;• buttons publish LOW when pressed and HIGH on release&lt;br&gt;• 30 ms debounce on TALK/navigation; 50 ms on encoder push&lt;br&gt;• encoder steps change browser volume by 5%&lt;br&gt;• encoder push toggles mute&lt;br&gt;• thinking state chases LOCAL → CLOUD → LISTEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;strokeWidth=2;fontColor=#4A148C;fontSize=14;align=left;spacingLeft=20;verticalAlign=top;spacingTop=16;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="620" width="650" height="210" as="geometry"/></mxCell>
        <mxCell id="p2-warning" value="Do not connect a powered 5 V encoder module to these GPIO inputs. Use a bare mechanical encoder, or a module verified for 3.3 V logic. LED polarity matters: long lead/anode faces GPIO; short lead/flat side faces the resistor and GND." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;strokeWidth=3;fontColor=#BF360C;fontSize=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="170" y="1030" width="1560" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="xdrive-audio-power" name="3 · Audio, display &amp; power">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="p3-title" value="Audio, display, and power · bench wiring" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1000" height="45" as="geometry"/></mxCell>
        <mxCell id="p3-sub" value="USB carries audio; micro-HDMI carries video; J2 remains electrically separate from every breadboard rail." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#44546F;" vertex="1" parent="1"><mxGeometry x="42" y="70" width="1300" height="30" as="geometry"/></mxCell>
        <mxCell id="mic3" value="&lt;b&gt;Electret capsule&lt;/b&gt;&lt;br&gt;+ lead&lt;br&gt;− / case lead" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontColor=#0D47A1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="140" height="140" as="geometry"/></mxCell>
        <mxCell id="usb3" value="&lt;b&gt;USB audio adapter&lt;/b&gt;&lt;br&gt;&lt;br&gt;MIC signal/bias ← capsule +&lt;br&gt;MIC sleeve ← capsule −&lt;br&gt;&lt;br&gt;HEADPHONE L → amplifier IN&lt;br&gt;HEADPHONE GND → amplifier GND&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Do not short L and R together&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#6A1B9A;strokeWidth=3;fontColor=#4A148C;fontSize=15;align=left;spacingLeft=18;verticalAlign=top;spacingTop=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="315" y="155" width="310" height="250" as="geometry"/></mxCell>
        <mxCell id="pi3" value="&lt;b&gt;Raspberry Pi 5&lt;/b&gt;&lt;br&gt;&lt;br&gt;USB-A host&lt;br&gt;micro-HDMI&lt;br&gt;physical pin 4 · 5 V&lt;br&gt;physical pin 6 · GND&lt;br&gt;J2 pad A / pad B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=3;fontColor=#1B5E20;fontSize=16;align=left;spacingLeft=24;verticalAlign=top;spacingTop=18;arcSize=8;" vertex="1" parent="1"><mxGeometry x="765" y="145" width="300" height="285" as="geometry"/></mxCell>
        <mxCell id="amp3" value="&lt;b&gt;PAM8302-class mono amplifier&lt;/b&gt;&lt;br&gt;&lt;br&gt;VIN ← regulated 5 V&lt;br&gt;GND ← supply/audio GND&lt;br&gt;IN ← one headphone channel&lt;br&gt;SPK+ → speaker lead 1&lt;br&gt;SPK− → speaker lead 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=3;fontColor=#880E4F;fontSize=15;align=left;spacingLeft=18;verticalAlign=top;spacingTop=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="155" width="310" height="250" as="geometry"/></mxCell>
        <mxCell id="speaker3" value="&lt;b&gt;Raw speaker&lt;/b&gt;&lt;br&gt;confirm impedance&lt;br&gt;and power rating" style="shape=mxgraph.electrical.audio.speaker;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;fontColor=#880E4F;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1690" y="210" width="115" height="135" as="geometry"/></mxCell>
        <mxCell id="display3" value="&lt;b&gt;Small HDMI display&lt;/b&gt;&lt;br&gt;&lt;br&gt;HDMI input ← Pi micro-HDMI&lt;br&gt;USB power/touch ← rated USB source&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Use the display vendor's required current rating&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;strokeWidth=3;fontColor=#006064;fontSize=16;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1200" y="545" width="380" height="185" as="geometry"/></mxCell>
        <mxCell id="power3" value="&lt;b&gt;POWER momentary switch&lt;/b&gt;&lt;br&gt;&lt;br&gt;terminal 1 → J2 pad A&lt;br&gt;terminal 2 → J2 pad B&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Brief closure = normal power action&lt;br&gt;Long hold = forced shutdown path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=3;fontColor=#B71C1C;fontSize=16;arcSize=8;" vertex="1" parent="1"><mxGeometry x="765" y="545" width="300" height="185" as="geometry"/></mxCell>
        <mxCell id="amp-power-note" value="&lt;b&gt;Amplifier power choice&lt;/b&gt;&lt;br&gt;&lt;br&gt;A: Pi pin 4 (5 V) and pin 6 (GND), only after confirming total USB/display/amp current fits the supply budget.&lt;br&gt;&lt;br&gt;B: separate regulated 5 V supply. Join its GND to audio/Pi GND for the amplifier input reference, but never join either SPK output to GND." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;strokeWidth=2;fontColor=#5D4037;fontSize=14;align=left;spacingLeft=20;verticalAlign=top;spacingTop=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="525" width="540" height="225" as="geometry"/></mxCell>
        <mxCell id="bom" value="&lt;b&gt;Bench BOM&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Pi 5 + rated PSU + flashed SD card&lt;br&gt;• class-compliant USB audio adapter with biased MIC input&lt;br&gt;• raw electret capsule&lt;br&gt;• PAM8302-class 5 V mono amplifier&lt;br&gt;• verified speaker&lt;br&gt;• 3 LEDs + three 330 Ω resistors&lt;br&gt;• 8 NO buttons: TALK, POWER, UP, DOWN, LEFT, RIGHT, OK, BACK&lt;br&gt;• passive rotary encoder with push&lt;br&gt;• small HDMI display + cables/power&lt;br&gt;• breadboard + jumpers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#78909C;strokeWidth=2;fontColor=#263238;fontSize=14;align=left;spacingLeft=20;verticalAlign=top;spacingTop=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="235" y="830" width="620" height="285" as="geometry"/></mxCell>
        <mxCell id="bringup" value="&lt;b&gt;Bring-up gates&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Buttons + LEDs, no amp connected&lt;br&gt;2. USB microphone capture&lt;br&gt;3. USB headphone output into powered amp&lt;br&gt;4. Speaker at low volume&lt;br&gt;5. HDMI display and touch/power&lt;br&gt;6. J2 switch wired last, with Pi power disconnected&lt;br&gt;&lt;br&gt;Stop if any GPIO sees more than 3.3 V or the amplifier/speaker becomes hot." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontColor=#1B5E20;fontSize=14;align=left;spacingLeft=20;verticalAlign=top;spacingTop=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1020" y="830" width="620" height="285" as="geometry"/></mxCell>
        <mxCell id="mic-usb3" value="MIC signal + sleeve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1976D2;strokeWidth=3;fontColor=#0D47A1;fontSize=12;" edge="1" parent="1" source="mic3" target="usb3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="usb-pi3" value="USB digital audio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B1FA2;strokeWidth=3;fontColor=#4A148C;fontSize=12;" edge="1" parent="1" source="usb3" target="pi3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="usb-amp3" value="HEADPHONE L + GND" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B1FA2;strokeWidth=3;fontColor=#4A148C;fontSize=12;" edge="1" parent="1" source="usb3" target="amp3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="amp-speaker3" value="floating SPK+ / SPK− pair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C2185B;strokeWidth=4;fontColor=#880E4F;fontSize=12;" edge="1" parent="1" source="amp3" target="speaker3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pi-display3" value="micro-HDMI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#00838F;strokeWidth=3;fontColor=#006064;fontSize=12;" edge="1" parent="1" source="pi3" target="display3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pi-power3" value="J2 pad A / B only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#D32F2F;strokeWidth=4;fontColor=#B71C1C;fontSize=12;" edge="1" parent="1" source="pi3" target="power3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p3-warning" value="Never connect the speaker directly to GPIO or the USB headphone jack. Never ground SPK+ or SPK− on a bridge-output amplifier. Never apply supply voltage to J2. Confirm mic polarity, speaker impedance, and display/amp current requirements before soldering." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=3;fontColor=#B71C1C;fontSize=15;arcSize=8;" vertex="1" parent="1"><mxGeometry x="130" y="1140" width="1640" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
