{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mxgenius.io/schemas/edge/scan-observation-1.0.0.json",
  "title": "MXG Edge Scan Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema", "schemaVersion", "eventId", "nodeId", "sequence", "observedAtMs", "device", "symbology", "rawValue", "rawSha256", "normalized"],
  "properties": {
    "type": {"const": "scan.observed"},
    "schema": {"const": "mxg.edge.scan"},
    "schemaVersion": {"const": "1.0.0"},
    "eventId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "nodeId": {"type": "string", "minLength": 1, "maxLength": 128},
    "sessionId": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "observedAtMs": {"type": "integer", "minimum": 0},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "profile", "transport"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "transport": {"enum": ["usb-cdc", "usb-hid", "serial", "bluetooth-spp", "bluetooth-hid", "simulated", "unknown"]}
      }
    },
    "symbology": {"type": "string", "minLength": 1, "maxLength": 32},
    "rawValue": {"type": "string", "minLength": 1, "maxLength": 512},
    "rawSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalized": {
      "type": "object",
      "required": ["value", "verified"],
      "properties": {
        "value": {"type": "string"},
        "verified": {"const": false},
        "identifierCandidate": {"type": "string"},
        "partNumber": {"type": "string"},
        "serialNumber": {"type": "string"},
        "lotNumber": {"type": "string"},
        "gs1": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
