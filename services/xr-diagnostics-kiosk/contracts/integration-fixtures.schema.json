{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mxgenius.io/schemas/integration-fixtures.schema.json",
  "title": "MxGenius normalized integration fixture registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "generatedAtMs", "notice", "integrations"],
  "properties": {
    "type": { "const": "integration.fixtures" },
    "version": { "const": 1 },
    "generatedAtMs": { "type": "integer", "minimum": 0 },
    "notice": { "type": "string", "minLength": 1 },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "label", "mode", "auth", "description", "contract", "sample"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["public-adapter", "fixture", "contract-fixture"] },
          "auth": { "enum": ["none", "pending"] },
          "description": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "pattern": "^mxg\\." },
          "sample": {
            "type": "object",
            "required": ["type", "status", "source", "operationalConclusion"],
            "properties": {
              "status": { "const": "fixture" },
              "source": {
                "type": "object",
                "required": ["provider", "reference"],
                "properties": { "reference": { "type": "string", "pattern": "^fixture://" } }
              },
              "operationalConclusion": { "type": "null" }
            }
          }
        }
      }
    }
  }
}
